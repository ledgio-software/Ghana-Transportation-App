# Secrets for edge functions. Locally: copy to supabase/functions/.env (git-ignored).
# In Supabase: `supabase secrets set --env-file ...` per environment (dev, staging, prod).
SEND_SMS_HOOK_SECRETS=v1,whsec_replace_me
SMS_SENDER_ID=GhTransport
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
# Local only: log OTPs instead of sending when no vendor keys are set.
SMS_ALLOW_CONSOLE=true
# SMSGATE_USERNAME=          # SMSGate (Android phone gateway), optional last fallback
# SMSGATE_PASSWORD=
