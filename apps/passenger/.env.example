# Copy to .env.local. Values per environment (development, staging, production).
# The publishable (anon) key is safe in the app; row level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Optional: link to the full lawyer-approved terms and privacy notice.
# Optional: Google Maps Embed API key (restricted to the web app's address and the Embed API)
# for the route map. Without it the app still links to directions in Google Maps.
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# The web app's address; the Android map uses it so the referrer-restricted key works.
EXPO_PUBLIC_WEB_URL=
# Not here: the live map's road line needs GOOGLE_ROUTES_KEY (a Google key restricted to the
# Routes API only) as a server environment variable in the Vercel project. It must stay private.
